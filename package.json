{
  "name": "@hussmartinez/pdf-sdk",
  "version": "0.1.0",
  "description": "Client-side PDF SDK: a headless core, a React editor and a custom element. Files never leave the device.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ie-huss-martinez/pdf-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ie-huss-martinez/pdf-sdk/issues"
  },
  "homepage": "https://github.com/ie-huss-martinez/pdf-sdk#readme",
  "keywords": [
    "pdf",
    "pdf-editor",
    "react",
    "web-component",
    "client-side"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "changeset": "changeset",
    "lint": "biome check .",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:deps": "hm-lint-deps src",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "build": "vite build && pnpm check:api",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:browser:all": "vitest run --project browser --mode all-browsers",
    "check:size": "size-limit",
    "check:api": "tsc -p tsconfig.build.json && api-extractor run && api-extractor run -c api-extractor.react.json && api-extractor run -c api-extractor.element.json && hm-check-api-reports --main api/pdf-sdk.api.md --types dist/index.d.ts api/pdf-sdk-react.api.md api/pdf-sdk-element.api.md",
    "check:package": "publint run --pack pnpm --strict && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css",
    "api:update": "tsc -p tsconfig.build.json && api-extractor run --local && api-extractor run -c api-extractor.react.json --local && api-extractor run -c api-extractor.element.json --local && hm-check-api-reports --main api/pdf-sdk.api.md --types dist/index.d.ts api/pdf-sdk-react.api.md api/pdf-sdk-element.api.md",
    "verify": "pnpm lint && pnpm lint:css && pnpm typecheck && pnpm lint:deps && pnpm build && pnpm test && pnpm test:browser && pnpm build:examples && pnpm test:e2e && pnpm check:size && pnpm check:api && pnpm check:package",
    "verify:fast": "pnpm typecheck && pnpm test && pnpm lint:deps && pnpm check:api",
    "build:examples": "pnpm --filter \"./examples/*\" build",
    "test:e2e": "pnpm --filter @hussmartinez/pdf-sdk-e2e test:e2e"
  },
  "dependencies": {
    "@hussmartinez/sdk-core": "catalog:",
    "@hussmartinez/ui": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.3",
    "react-dom": ">=18.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@biomejs/biome": "catalog:",
    "@cantoo/pdf-lib": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@hussmartinez/sdk-config": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@size-limit/file": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "dependency-cruiser": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "pdfjs-dist": "catalog:",
    "pdfstudio": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "secretlint": "catalog:",
    "size-limit": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
